# Copy to env.sh and edit only the settings that differ on your local Hadoop VM.
# The scripts source env.sh automatically. For manual Python commands:
# source env.sh

# HDFS_BIN is discovered on PATH or under HADOOP_HOME/bin by default.
# export HADOOP_HOME=/path/to/hadoop
# export HADOOP_CONF_DIR="$HADOOP_HOME/etc/hadoop"
# export HDFS_BIN="$HADOOP_HOME/bin/hdfs"

# The NameNode URI is discovered using hdfs getconf by default.
# export HDFS_URI=hdfs://localhost:9000

# Defaults to your OS username and /user/<username>/day60.
# export HADOOP_USER_NAME="$(id -un)"
# export DAY60_HDFS_BASE="/user/$(id -un)/day60"

export WEBHDFS_HOST=localhost
export WEBHDFS_PORT=9870
export STREAMLIT_BIND_ADDRESS=127.0.0.1
